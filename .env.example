# WeCare Frontend Web Admin Configuration
# ==============================================================================
# In Railway: Set VITE_API_BASE_URL to your deployed Backend API URL
# Example: https://your-backend-api.up.railway.app/api/v1
# ==============================================================================

# Backend API Endpoint
VITE_API_BASE_URL=https://your-backend-api.up.railway.app/api/v1

# Router Base Path (Default: /admin or use / for root domain)
VITE_ROUTER_BASE=/admin

# Disable mock mode for production live data
VITE_DEV_MOCK_MODE=false
